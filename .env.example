# Used by the Electron app and by `vite --config vite.web.config.ts`.
# In production the website talks to the same host, so this can stay empty there.
VITE_SERVER_URL=ws://127.0.0.1:4737
VITE_PUBLIC_URL=http://127.0.0.1:5173

# Optional desktop download buttons on the welcome screen.
# VITE_DOWNLOAD_MAC=https://github.com/you/fodinha/releases/latest/download/Fodinha-darwin-arm64.zip
# VITE_DOWNLOAD_WIN=https://github.com/you/fodinha/releases/latest/download/Fodinha-win32-x64.exe
# VITE_DOWNLOAD_LINUX=https://github.com/you/fodinha/releases/latest/download/fodinha_amd64.deb
