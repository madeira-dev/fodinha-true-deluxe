{
  "name": "fodinha-electron",
  "productName": "fodinha-electron",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "tsx src/server/main.ts",
    "web": "vite --config vite.web.config.ts",
    "dev": "concurrently -k \"npm run server\" \"npm run web\"",
    "build:web": "vite build --config vite.web.config.ts",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=cjs --outfile=dist/server.js --external:ws",
    "build:online": "npm run build:web && npm run build:server",
    "start:online": "node dist/server.js"
  },
  "keywords": [],
  "author": {
    "name": "Gabriel Madeira",
    "email": "gabriel.madeira@testrigor.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "concurrently": "^10.0.5",
    "electron": "44.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "happy-dom": "^20.12.0",
    "tsx": "^4.23.13",
    "typescript": "~4.5.4",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "ws": "^8.21.3"
  }
}
