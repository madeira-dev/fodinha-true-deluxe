# Used by the Electron app and by `vite --config vite.web.config.ts`.
# In production the website talks to the same host, so this can stay empty there.
VITE_SERVER_URL=ws://127.0.0.1:4737
VITE_PUBLIC_URL=http://127.0.0.1:5173

# Desktop downloads. Defaults point at GitHub Releases.
# VITE_DOWNLOAD_MAC=https://github.com/madeira-dev/fodinha-true-deluxe/releases/latest/download/Fodinha-mac.zip
# VITE_DOWNLOAD_WIN=https://github.com/madeira-dev/fodinha-true-deluxe/releases/latest/download/Fodinha-windows.zip
# VITE_DOWNLOAD_LINUX=https://github.com/madeira-dev/fodinha-true-deluxe/releases/latest/download/Fodinha-linux.zip
